{
  "manifest_version": 3,
  "name": "WebsiteTimeTrack",
  "version": "2.1.0",
  "description": "Measures your time on every website, locally – with limits, focus mode, categories and a weekly report.",
  "browser_specific_settings": {
    "gecko": {
      "id": "websitetimetrack@local",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms",
    "notifications"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
